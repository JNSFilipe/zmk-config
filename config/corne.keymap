#include <dt-bindings/led/led.h>
#include <dt-bindings/zmk/reset.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

&led_strip { chain-length = <27>; };

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "BAS";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp TAB                         &kp Q    &kp W    &kp E             &kp R                    &kp T                  &kp Y                     &kp U                 &kp I                    &kp O    &kp P      &kp MINUS
&kp LS(LA(LC(LG(LEFT_SHIFT))))  &lt 1 A  &lt 2 S  &kp D             &kp F                    &kp G                  &kp H                     &kp J                 &kp K                    &kp L    &kp GRAVE  &kp SQT
&kp LEFT_SHIFT                  &kp Z    &kp X    &kp C             &kp V                    &kp B                  &kp N                     &kp M                 &kp COMMA                &kp DOT  &kp FSLH   &kp BSLH
                                                  &mt LCTRL ESCAPE  &mt RIGHT_ALT BACKSPACE  &mt LEFT_META SPACE    &mt RIGHT_COMMAND RETURN  &mt RIGHT_ALT DELETE  &mt RIGHT_CONTROL COLON
            >;
        };

        lower_layer {
            display-name = "LOW";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TAB    &kp ASTERISK  &kp PLUS      &kp N7            &kp NUMBER_8            &kp N5                    &kp EXCLAMATION        &kp DOUBLE_QUOTES     &kp HASH         &kp DOLLAR        &kp LEFT_BRACE        &kp RIGHT_BRACE
&kp SLASH  &trans        &kp MINUS     &kp NUMBER_4      &kp NUMBER_5            &kp NUMBER_6              &kp LEFT               &kp DOWN              &kp UP           &kp RIGHT         &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp LSHFT  &kp EQUAL     &kp NUMBER_0  &kp NUMBER_1      &kp NUMBER_2            &kp NUMBER_3              &kp PERCENT            &kp AMPERSAND         &kp LESS_THAN    &kp GREATER_THAN  &kp LEFT_BRACKET      &kp RIGHT_BRACKET
                                       &mt LCTRL ESCAPE  &mt LEFT_ALT BACKSPACE  &mt LEFT_COMMAND SPACE    &mt RIGHT_COMMAND RET  &mt RIGHT_ALT DELETE  &mt RCTRL COLON
            >;
        };

        raise_layer {
            display-name = "RAI";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TAB    &kp EXCL  &kp AT  &kp HASH  &kp DLLR        &kp PRCNT    &kp CARET  &kp AMPS        &kp KP_MULTIPLY  &kp LPAR  &kp RPAR  &kp BSPC
&kp LCTRL  &trans    &trans  &trans    &trans          &trans       &kp MINUS  &kp EQUAL       &kp LBKT         &kp RBKT  &kp BSLH  &kp GRAVE
&kp LSHFT  &trans    &trans  &trans    &trans          &trans       &kp UNDER  &kp PLUS        &kp LBRC         &kp RBRC  &kp PIPE  &kp TILDE
                             &kp LGUI  &studio_unlock  &kp SPACE    &kp RET    &studio_unlock  &kp RALT
            >;
        };
    };
};
