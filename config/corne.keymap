#include <dt-bindings/led/led.h>
#include <dt-bindings/zmk/reset.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&led_strip { chain-length = <27>; };

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "BAS";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp ESCAPE                          &kp Q    &kp W    &kp E          &kp R                    &kp T                  &kp Y                    &kp U                 &kp I                    &kp O    &kp P      &kp MINUS
&mt LS(LA(LC(LG(LEFT_SHIFT)))) TAB  &lt 1 A  &lt 2 S  &kp D          &kp F                    &kp G                  &kp H                    &kp J                 &kp K                    &kp L    &kp GRAVE  &kp SQT
&kp LEFT_SHIFT                      &kp Z    &kp X    &kp C          &kp V                    &kp B                  &kp N                    &kp M                 &kp COMMA                &kp DOT  &kp MINUS  &kp BSLH
                                                      &mt LCTRL RET  &mt RIGHT_ALT BACKSPACE  &mt LEFT_META SPACE    &mt RIGHT_COMMAND SPACE  &mt RIGHT_ALT DELETE  &mt RIGHT_CONTROL ENTER
            >;
        };

        math_layer {
            display-name = "MTH";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TAB      &trans  &kp PLUS      &kp N7            &kp NUMBER_8            &kp N5                    &kp ASTERISK           &kp SLASH             &kp EQUAL        &kp HASH          &kp LEFT_BRACE        &kp RIGHT_BRACE
&kp AT_SIGN  &trans  &kp MINUS     &kp NUMBER_4      &kp NUMBER_5            &kp NUMBER_6              &kp LEFT               &kp DOWN              &kp UP           &kp RIGHT         &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp LSHFT    &trans  &kp NUMBER_0  &kp NUMBER_1      &kp NUMBER_2            &kp NUMBER_3              &kp PERCENT            &kp AMPERSAND         &kp LESS_THAN    &kp GREATER_THAN  &kp LEFT_BRACKET      &kp RIGHT_BRACKET
                                   &mt LCTRL ESCAPE  &mt LEFT_ALT BACKSPACE  &mt LEFT_COMMAND SPACE    &mt RIGHT_COMMAND RET  &mt RIGHT_ALT DELETE  &mt RCTRL COLON
            >;
        };

        symbol_layer {
            display-name = "SYM";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TAB    &kp EXCL    &bt BT_CLR  &kp DOUBLE_QUOTES     &kp HASH                &kp DOLLAR                &kp PERCENT            &kp AMPERSAND         &kp SLASH        &kp EQUAL  &kp QUESTION  &kp ASTERISK
&kp LCTRL  &kp PERIOD  &trans      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS   &kp LEFT_BRACE            &kp LEFT_ARROW         &kp DOWN              &kp UP_ARROW     &kp RIGHT  &kp TILDE     &kp GRAVE
&kp LSHFT  &kp MINUS   &sys_reset  &kp LEFT_BRACKET      &kp RIGHT_BRACKET       &kp RIGHT_BRACE           &kp UNDER              &kp PLUS              &kp LBRC         &kp RBRC   &kp PIPE      &kp TILDE
                                   &mt LCTRL ESCAPE      &mt LEFT_ALT BACKSPACE  &mt LEFT_COMMAND SPACE    &mt RIGHT_COMMAND RET  &mt RIGHT_ALT DELETE  &mt RCTRL COLON
            >;
        };
    };
};
